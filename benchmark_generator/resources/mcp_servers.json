{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp/bench_fs"]
    },
    "clickhouse": {
      "command": "uvx",
      "args": ["mcp-clickhouse", "--no-banner"],
      "env": {
        "CLICKHOUSE_HOST": "localhost",
        "CLICKHOUSE_PORT": "8123",
        "CLICKHOUSE_SECURE": "false",
        "FASTMCP_SHOW_SERVER_BANNER": "false"
      }
    }
  }
}
