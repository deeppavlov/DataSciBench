{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/tmp/bench_fs"]
    },
    "clickhouse": {
      "command": "uvx",
      "args": ["clickhouse-mcp"],
      "env": {
        "CLICKHOUSE_HOST": "localhost",
        "CLICKHOUSE_PORT": "8123"
      }
    }
  }
}
